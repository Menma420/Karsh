{
  "name": "@personal-capability-os/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "cd ../../packages/shared-types && npm run build && cd ../../apps/api && npm run db:generate && tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate --schema=src/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=src/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=src/db/prisma/schema.prisma",
    "db:seed": "ts-node src/db/prisma/seed.ts"
  },
  "dependencies": {
    "@personal-capability-os/shared-types": "file:../../packages/shared-types",
    "@prisma/client": "^5.14.0",
    "argon2": "^0.40.1",
    "archiver": "^7.0.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "embedded-postgres": "^17.10.0-beta.17",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "schema": "src/db/prisma/schema.prisma",
    "seed": "ts-node src/db/prisma/seed.ts"
  }
}
